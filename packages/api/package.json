{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/init.js",
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "pnpm clear && tsc -p tsconfig.build.json",
    "postbuild": "node --env-file=.env.staging scripts/postbuild.js",
    "preview": "node --env-file=.env.staging dist/server.js",
    "typecheck": "tsc",
    "test": "vitest --run",
    "clear": "node scripts/clear.js",
    "clean": "node scripts/clean.js"
  },
  "dependencies": {
    "@hono/node-server": "2.0.10",
    "@hono/standard-validator": "0.3.0",
    "@libsql/client": "0.17.4",
    "drizzle-orm": "0.45.2",
    "hono": "catalog:",
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "@standard-schema/spec": "1.1.0",
    "@types/node": "catalog:",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.1",
    "tsx": "4.23.1",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "4.1.10"
  }
}
